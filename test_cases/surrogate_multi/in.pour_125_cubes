# Multi-particle surrogate test (Spec 06): 125 cubes (L = 1 cm) with random orientations fall onto
# a floor inside a box (6 primitive walls). First test with many surrogate particles and several
# processors.
#
# Contact model status (2026-11-18):
#   cube-wall : surrogate (run_029), contact point STOPGAP (Spec 04 R04.2b)
#   cube-cube : PLACEHOLDER -- there is no surrogate pair model yet (Spec 04 R04.7, needs a
#               cube-cube model from the surrogate team). pair_style gran uses 'surface default',
#               i.e. cubes collide with each other as SPHERES of the bounding radius 0.866 L.
#               This test is therefore a SOFTWARE / SCALING test (many particles, MPI, batched
#               model calls, no particle loss, no energy gain), NOT a physical packing result.
#
# Run:  SS_MODELS_DIR=<repo>/SS_models  [mpirun -np N]  liggghts -in in.pour_125_cubes

units           si
atom_style      surrogate ss-cube
atom_modify     map array
dimension       3
boundary        f f f
newton          off
communicate     single vel yes

variable        L equal 0.01
region          domain block -0.06 0.06 -0.06 0.06 0.0 0.20 units box
create_box      1 domain

# 5 x 5 x 5 = 125 cubes on a lattice, spacing 2.0 L, plus a random shift of <= 0.1 L, so the
# bounding spheres (diameter 1.73 L) never overlap at start. Lattice points (origin 0) at
# x,y = -0.040 ... +0.040 m, side walls at +-0.06 m (clearance 1.1 L beyond the bounding radius)
# -- no particle may start inside a wall or another particle; z = 0.06 ... 0.14 m.
lattice         sc 0.020 origin 0 0 0
region          fill block -0.041 0.041 -0.041 0.041 0.055 0.145 units box
create_atoms    1 region fill
displace_atoms  all random 0.0005 0.0005 0.0005 15013 units box

set             atom * diameter ${L}
set             atom * density 1000
set             atom * quat/random 15017

fix             m1 all property/global youngsModulus peratomtype 1.0e7
fix             m2 all property/global poissonsRatio peratomtype 0.25
fix             m3 all property/global coefficientRestitution peratomtypepair 1 0.6
fix             m4 all property/global coefficientFriction peratomtypepair 1 0.4

fix             integrate all nve/sphere
fix             gravity all gravity 9.81 vector 0.0 0.0 -1.0

fix             wz0 all wall/gran model hertz tangential history surface surrogate primitive type 1 zplane 0.0
fix             wz1 all wall/gran model hertz tangential history surface surrogate primitive type 1 zplane 0.2
fix             wx0 all wall/gran model hertz tangential history surface surrogate primitive type 1 xplane -0.06
fix             wx1 all wall/gran model hertz tangential history surface surrogate primitive type 1 xplane 0.06
fix             wy0 all wall/gran model hertz tangential history surface surrogate primitive type 1 yplane -0.06
fix             wy1 all wall/gran model hertz tangential history surface surrogate primitive type 1 yplane 0.06
# PLACEHOLDER (see header): sphere-sphere contact between cubes until a cube-cube surrogate exists
pair_style      gran model hertz tangential history surface default
pair_coeff      * *

neighbor        0.002 bin
neigh_modify    delay 0
timestep        0.00001

compute         ke all ke
compute         erot all erotate/surrogate
variable        epot equal mass(all)*9.81*xcm(all,z)
variable        etot equal c_ke+c_erot+v_epot
variable        zc equal xcm(all,z)
thermo          1000
thermo_style    custom step atoms v_zc c_ke c_erot v_epot v_etot
thermo_modify   format float %.10g lost error
modify_timing   verbose

shell           mkdir post
dump            dmpvtk all custom/vtk 2000 post/pour_*.vtk id type x y z vx vy vz omegax omegay omegaz radius mass quat1 quat2 quat3 quat4

run             30000
