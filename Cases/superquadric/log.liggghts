create_atoms 1 single 0.0 0.0 0.01
Created 1 atoms
set atom 1 type 2 shape 0.002 0.002 0.004 blockiness ${blockiness1} ${blockiness2} density 2500 vz 0.1 quat 1 0 0 ${a