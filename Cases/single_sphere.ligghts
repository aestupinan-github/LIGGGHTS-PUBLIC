# ============================================================
# Case 1: Single sphere (1 cm diameter) bouncing on a flat wall
# ============================================================

atom_style      granular
atom_modify     map array
boundary        f f f
newton          off
communicate     single vel yes

units           si
region          domain block -0.05 0.05 -0.05 0.05 -0.05 0.10 units box
create_box      1 domain

neighbor        0.002 bin
neigh_modify    delay 0

# ------------------------------------------------------------
# Material properties (Hertz)
# ------------------------------------------------------------
fix             m1 all property/global youngsModulus peratomtype 1.e9
fix             m2 all property/global poissonsRatio peratomtype 0.3
fix             m3 all property/global coefficientRestitution peratomtypepair 1 0.9
fix             m4 all property/global coefficientFriction peratomtypepair 1 0.3

pair_style      gran model hertz tangential history
pair_coeff      * *

timestep        1e-5

# ------------------------------------------------------------
# Single sphere, diameter 1 cm -> radius 0.005 m
# ------------------------------------------------------------
fix             pts1 all particletemplate/sphere 15485863 atom_type 1 &
                density constant 2500 radius constant 0.005

fix             pdd1 all particledistribution/discrete 32452843 1 pts1 1.0

# Place single particle at exact x, y, z
create_atoms    1 single 0.0 0.0 0.05

# Set granular radius (0.005 m) and density (2500 kg/m^3 -> mass = density * volume)
set             atom 1 diameter 0.01
set             atom 1 density 2500

fix             integr all nve/sphere
fix             grav all gravity 9.81 vector 0.0 0.0 -1.0

fix             wall1 all wall/gran model hertz tangential history &
                primitive type 1 zplane 0.0

# ------------------------------------------------------------
# Output
# ------------------------------------------------------------
compute         ke all erotate/sphere
thermo_style    custom step atoms ke time
thermo          100
thermo_modify   lost ignore norm no

dump            dmp all custom 50 sphere_bounce.dump id type x y z vx vy vz fx fy fz

# VTK output for ParaView (exports sphere meshes with radius and velocity)
dump            dmpVTK all custom/vtk 50 post/particle_*.vtk id type x y z vx vy vz fx fy fz radius

run             50000
