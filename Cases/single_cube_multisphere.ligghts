# ============================================================
# Case 2: 1 cm Cube approximated as an 8-sphere multisphere clump
# ============================================================

atom_style	sphere
atom_modify	map array sort 0 0
boundary	m m m
newton		off

communicate	single vel yes

# PUBLIC version supports serial execution
processors	1 1 1 

units		si

region		reg block -0.05 0.05 -0.05 0.05 0.0 0.10 units box
create_box	1 reg

neighbor	0.002 bin
neigh_modify	delay 0

# ------------------------------------------------------------
# Material properties
# ------------------------------------------------------------
fix 		m1 all property/global youngsModulus peratomtype 1.e9
fix 		m2 all property/global poissonsRatio peratomtype 0.3
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.9
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.3
fix 		m5 all property/global characteristicVelocity scalar 2.

pair_style 	gran model hertz tangential history
pair_coeff	* *

timestep        1e-6

fix		gravi all gravity 9.81 vector 0.0 0.0 -1.0
fix 		zwalls all wall/gran model hertz tangential history primitive type 1 zplane 0.0

# ------------------------------------------------------------
# Particle definition & insertion
# scale 0.0005 converts 20.0 unscaled units to 0.01 m (1 cm outer side length)
# ------------------------------------------------------------
fix		pts1 all particletemplate/multisphere 15485863 atom_type 1 &
		density constant 2500 nspheres 8 ntry 1000000 &
		spheres file cube_clump_rot.txt scale 0.0005 type 1
		

fix		pdd1 all particledistribution/discrete 15485867 1 pts1 1.0

# Insertion box
region		bc block -0.02 0.02 -0.02 0.02 0.02 0.06 units box

# volumefraction_region 0.015625 targets exactly 1 cube insertion
#fix		ins all insert/pack seed 32452843 distributiontemplate pdd1 vel constant 0. 0. -1. &
#		insert_every once overlapcheck yes region bc ntry_mc 100000 volumefraction_region 0.015625

# volumefraction_region 0.007 guarantees inserting exactly 1 cube
fix		ins all insert/pack seed 32452843 distributiontemplate pdd1 vel constant 0. 0. -1. &
		insert_every once overlapcheck yes region bc ntry_mc 100000 volumefraction_region 0.007

fix		integr all multisphere

# ------------------------------------------------------------
# Output settings
# ------------------------------------------------------------
compute		1 all erotate/sphere
fix		ts all check/timestep/gran 1000 0.1 0.1
thermo_style	custom step atoms ke c_1 f_ts[1] f_ts[2] vol
thermo		1000
thermo_modify	lost ignore norm no

# Step 1 initializes particle insertion before dump setup
run 1

# Rotate all atoms by 45 degrees around X-axis centered at (0, 0, 0.03)
#displace_atoms all rotate 0.0 0.0 0.03 1.0 0.0 0.0 45.0

dump		dmp all custom/vtk 2000 post/cube_*.vtk id type mol x y z vx vy vz fx fy fz omegax omegay omegaz radius

run		400000 upto
